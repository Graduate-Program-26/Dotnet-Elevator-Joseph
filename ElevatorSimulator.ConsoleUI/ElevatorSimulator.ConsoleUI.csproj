<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required for Razor components to know the root namespace -->
    <RootNamespace>ElevatorSimulator.ConsoleUI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- RazorConsole.Core already pulls in Spectre.Console transitively -->
    <PackageReference Include="RazorConsole.Core" Version="0.5.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElevatorSimulator.Core\ElevatorSimulator.Core.csproj" />
    <ProjectReference Include="..\ElevatorSimulator.Simulation\ElevatorSimulator.Simulation.csproj" />
    <ProjectReference Include="..\ElevatorSimulator.Infrastructure\ElevatorSimulator.Infrastructure.csproj" />
  </ItemGroup>

</Project>
